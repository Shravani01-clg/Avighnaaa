# AVIGHNAA backend environment variables
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Backend port — must match API_BASE_URL in frontend/script.js
PORT=5002

# Supabase (same existing project). SECRET_KEY = service-role key, BACKEND ONLY.
SUPABASE_URL=your-supabase-project-url
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY_HERE
# ESP32 / simulator shared key (x-device-key header)
DEVICE_API_KEY=your-device-api-key-here

# Python AI module (optional; backend falls back to rule-based risk if down)
AI_SERVER_URL=http://localhost:5001

# Rescue layer (all optional — defaults shown)
# Minimum alert severity that creates an incident: LOW | MEDIUM | HIGH | CRITICAL
INCIDENT_MIN_SEVERITY=HIGH
# Minutes before an unacknowledged incident is escalated
RESPONSE_TIMEOUT_MINUTES=5
# Minutes with no new incident for the same device after a resolved one
INCIDENT_COOLDOWN_MINUTES=10
# Escalation scheduler interval (ms)
ESCALATION_CHECK_MS=30000
# Device considered offline after this many seconds without a reading
DEVICE_OFFLINE_SECONDS=60
